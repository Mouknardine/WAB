# ── WeAreBrothers Studio — configuration serveur (Infomaniak / Apache) ──
# N'affecte pas le rendu : redirections canoniques, compression et cache.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forcer HTTPS + domaine sans www EN UN SEUL SAUT (cohérent avec les canonical)
    # http, http://www et https://www atteignent https://wearebrothers.ch en un seul 301.
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # ── URLs propres (sans .html) ──
    # 1. Rediriger les anciennes adresses .html vers les adresses propres
    #    (seulement les requêtes directes du navigateur, pas les réécritures internes).
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^ / [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+work\.html[\s?] [NC]
    RewriteRule ^ /realisations [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+about\.html[\s?] [NC]
    RewriteRule ^ /studio [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+contact\.html[\s?] [NC]
    RewriteRule ^ /contact [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+applications\.html[\s?] [NC]
    RewriteRule ^ /applications [R=301,L]

    # 2. Enlever un slash final éventuel (garde les chemins d'assets relatifs corrects).
    RewriteRule ^(realisations|studio|contact|applications)/$ /$1 [R=301,L]

    # 3. Servir les adresses propres avec les fichiers physiques (réécriture interne).
    RewriteRule ^realisations$ work.html [L]
    RewriteRule ^studio$ about.html [L]
    RewriteRule ^contact$ contact.html [L]
    RewriteRule ^applications$ applications.html [L]
</IfModule>

# ── Compression (gzip / deflate) ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache navigateur ──
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # La police du site ne change jamais sans changer de nom de fichier :
    # elle peut rester un an dans le cache du visiteur.
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── En-têtes de sécurité (sans impact sur le rendu) ──
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Types MIME (le manifeste n'est pas connu de tous les serveurs)
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/x-icon .ico
    # Sans le bon type, le preload de la police est ignore et le
    # navigateur la retelecharge une seconde fois.
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# UTF-8 par défaut
AddDefaultCharset UTF-8
